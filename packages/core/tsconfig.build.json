{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "paths": {
      "@rxova/journey-common": ["packages/common/dist/index.d.ts"],
      "@rxova/journey-common/*": ["packages/common/dist/*.d.ts"]
    }
  },
  "references": [
    {
      "path": "../common/tsconfig.build.json"
    }
  ],
  "include": ["src"],
  "exclude": ["dist", "**/*.d.ts", "**/*.d.ts.map", "node_modules"]
}
