{
  "name": "@rxova/journey-core",
  "version": "1.0.0-rc.2",
  "description": "Journey core state machine.",
  "keywords": [
    "journey",
    "state-machine",
    "flow",
    "wizard",
    "stepper",
    "typescript",
    "graph",
    "finite-state",
    "workflow"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./connectors/immer": {
      "types": {
        "import": "./dist/connectors/immer/immer.d.ts",
        "require": "./dist/connectors/immer/immer.d.cts"
      },
      "import": "./dist/connectors/immer/immer.js",
      "require": "./dist/connectors/immer/immer.cjs"
    },
    "./analytics": {
      "types": {
        "import": "./dist/plugins/analytics/analytics.d.ts",
        "require": "./dist/plugins/analytics/analytics.d.cts"
      },
      "import": "./dist/plugins/analytics/analytics.js",
      "require": "./dist/plugins/analytics/analytics.cjs"
    },
    "./autosave": {
      "types": {
        "import": "./dist/plugins/autosave/autosave.d.ts",
        "require": "./dist/plugins/autosave/autosave.d.cts"
      },
      "import": "./dist/plugins/autosave/autosave.js",
      "require": "./dist/plugins/autosave/autosave.cjs"
    },
    "./diagnostics": {
      "types": {
        "import": "./dist/plugins/diagnostics/diagnostics.d.ts",
        "require": "./dist/plugins/diagnostics/diagnostics.d.cts"
      },
      "import": "./dist/plugins/diagnostics/diagnostics.js",
      "require": "./dist/plugins/diagnostics/diagnostics.cjs"
    },
    "./persistence": {
      "types": {
        "import": "./dist/plugins/persistence/persistence.d.ts",
        "require": "./dist/plugins/persistence/persistence.d.cts"
      },
      "import": "./dist/plugins/persistence/persistence.js",
      "require": "./dist/plugins/persistence/persistence.cjs"
    },
    "./replay": {
      "types": {
        "import": "./dist/plugins/replay/replay.d.ts",
        "require": "./dist/plugins/replay/replay.d.cts"
      },
      "import": "./dist/plugins/replay/replay.js",
      "require": "./dist/plugins/replay/replay.cjs"
    },
    "./subscription-enhancer": {
      "types": {
        "import": "./dist/plugins/subscription-enhancer/subscription-enhancer.d.ts",
        "require": "./dist/plugins/subscription-enhancer/subscription-enhancer.d.cts"
      },
      "import": "./dist/plugins/subscription-enhancer/subscription-enhancer.js",
      "require": "./dist/plugins/subscription-enhancer/subscription-enhancer.cjs"
    },
    "./execution-paths": {
      "types": {
        "import": "./dist/plugins/execution-paths/execution-paths.d.ts",
        "require": "./dist/plugins/execution-paths/execution-paths.d.cts"
      },
      "import": "./dist/plugins/execution-paths/execution-paths.js",
      "require": "./dist/plugins/execution-paths/execution-paths.cjs"
    },
    "./convert": {
      "types": {
        "import": "./dist/convert/convert.d.ts",
        "require": "./dist/convert/convert.d.cts"
      },
      "import": "./dist/convert/convert.js",
      "require": "./dist/convert/convert.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../common/tooling/copy-types.ts dist",
    "clean": "node --import tsx ../common/tooling/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "coverage": "JOURNEY_COVERAGE_INCLUDE=packages/core/src/** JOURNEY_COVERAGE_DIR=coverage/core pnpm --workspace-root vitest run packages/core/src --coverage --coverage.reporter=text-summary",
    "test": "pnpm --workspace-root vitest run packages/core/src --coverage.enabled=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:exports": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "devDependencies": {
    "@rxova/journey-common": "workspace:*",
    "immer": "^11.1.15"
  },
  "peerDependencies": {
    "immer": "^11.1.15"
  },
  "peerDependenciesMeta": {
    "immer": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "core/createLinearJourney",
      "path": "dist/index.js",
      "import": "{ createLinearJourney }",
      "limit": "5.6 kB"
    },
    {
      "name": "core/createGraphJourney",
      "path": "dist/index.js",
      "import": "{ createGraphJourney }",
      "limit": "5.75 kB"
    },
    {
      "name": "core/createGraphJourneyBuilder",
      "path": "dist/index.js",
      "import": "{ createGraphJourneyBuilder }",
      "limit": "750 B"
    },
    {
      "name": "core/immerConnector",
      "path": "dist/connectors/immer/immer.js",
      "import": "{ immerConnector }",
      "limit": "100 B"
    },
    {
      "name": "core/linearToGraphDefinition",
      "path": "dist/convert/convert.js",
      "import": "{ linearToGraphDefinition }",
      "limit": "450 B"
    },
    {
      "name": "core/createExecutionPathsPlugin",
      "path": "dist/plugins/execution-paths/execution-paths.js",
      "import": "{ createExecutionPathsPlugin }",
      "limit": "300 B"
    },
    {
      "name": "core/createAnalyticsPlugin",
      "path": "dist/plugins/analytics/analytics.js",
      "import": "{ createAnalyticsPlugin }",
      "limit": "500 B"
    },
    {
      "name": "core/createAutosavePlugin",
      "path": "dist/plugins/autosave/autosave.js",
      "import": "{ createAutosavePlugin }",
      "limit": "750 B"
    },
    {
      "name": "core/createDiagnosticsPlugin",
      "path": "dist/plugins/diagnostics/diagnostics.js",
      "import": "{ createDiagnosticsPlugin }",
      "limit": "850 B"
    },
    {
      "name": "core/createPersistencePlugin",
      "path": "dist/plugins/persistence/persistence.js",
      "import": "{ createPersistencePlugin }",
      "limit": "500 B"
    },
    {
      "name": "core/createReplayPlugin",
      "path": "dist/plugins/replay/replay.js",
      "import": "{ createReplayPlugin }",
      "limit": "850 B"
    },
    {
      "name": "core/createSubscriptionEnhancerPlugin",
      "path": "dist/plugins/subscription-enhancer/subscription-enhancer.js",
      "import": "{ createSubscriptionEnhancerPlugin }",
      "limit": "250 B"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.18"
  }
}
