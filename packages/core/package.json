{
  "name": "@rxova/journey-core",
  "version": "1.0.0",
  "description": "Journey core state machine.",
  "keywords": [
    "journey",
    "state-machine",
    "flow",
    "wizard",
    "stepper",
    "typescript",
    "graph",
    "finite-state",
    "workflow",
    "journey-machine",
    "multi-step-form",
    "multi-step",
    "onboarding",
    "checkout-flow",
    "branching",
    "guards",
    "transitions",
    "history",
    "time-travel",
    "zero-dependency",
    "vanilla-js",
    "framework-agnostic",
    "state-management"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugins": {
      "types": {
        "import": "./dist/plugins/index.d.ts",
        "require": "./dist/plugins/index.d.cts"
      },
      "import": "./dist/plugins/index.js",
      "require": "./dist/plugins/index.cjs"
    },
    "./connectors/immer": {
      "types": {
        "import": "./dist/connectors/immer/immer.d.ts",
        "require": "./dist/connectors/immer/immer.d.cts"
      },
      "import": "./dist/connectors/immer/immer.js",
      "require": "./dist/connectors/immer/immer.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../../scripts/packages/clean-paths.ts dist/internal && node --import tsx ../../scripts/packages/copy-types.ts dist",
    "clean": "node --import tsx ../../scripts/packages/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "check:exports": "publint --strict",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "immer": "^11.1.15",
    "publint": "^0.3.24"
  },
  "peerDependencies": {
    "immer": "^11.1.15"
  },
  "peerDependenciesMeta": {
    "immer": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "core/createLinearJourney",
      "path": "dist/index.js",
      "import": "{ createLinearJourney }",
      "limit": "6.2 kB"
    },
    {
      "name": "core/createGraphJourney",
      "path": "dist/index.js",
      "import": "{ createGraphJourney }",
      "limit": "6.5 kB"
    },
    {
      "name": "core/immerConnector",
      "path": "dist/connectors/immer/immer.js",
      "import": "{ immerConnector }",
      "limit": "100 B"
    },
    {
      "name": "core/createExecutionPathsPlugin",
      "path": "dist/plugins/index.js",
      "import": "{ createExecutionPathsPlugin }",
      "limit": "300 B"
    },
    {
      "name": "core/createAnalyticsPlugin",
      "path": "dist/plugins/index.js",
      "import": "{ createAnalyticsPlugin }",
      "limit": "500 B"
    },
    {
      "name": "core/analyzeStructure",
      "path": "dist/index.js",
      "import": "{ analyzeStructure }",
      "limit": "1.5 kB"
    },
    {
      "name": "core/createPersistencePlugin",
      "path": "dist/plugins/index.js",
      "import": "{ createPersistencePlugin }",
      "limit": "1.15 kB"
    },
    {
      "name": "core/createReplayPlugin",
      "path": "dist/plugins/index.js",
      "import": "{ createReplayPlugin }",
      "limit": "850 B"
    }
  ]
}
