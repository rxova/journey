{
  "name": "@rxova/journey-core",
  "version": "1.0.0-rc.2",
  "description": "Journey core state machine.",
  "keywords": [
    "journey",
    "state-machine",
    "flow",
    "wizard",
    "stepper",
    "typescript",
    "graph",
    "finite-state",
    "workflow"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./analytics": {
      "types": {
        "import": "./dist/plugins/analytics/index.d.ts",
        "require": "./dist/plugins/analytics/index.d.cts"
      },
      "import": "./dist/plugins/analytics/index.js",
      "require": "./dist/plugins/analytics/index.cjs"
    },
    "./autosave": {
      "types": {
        "import": "./dist/plugins/autosave/index.d.ts",
        "require": "./dist/plugins/autosave/index.d.cts"
      },
      "import": "./dist/plugins/autosave/index.js",
      "require": "./dist/plugins/autosave/index.cjs"
    },
    "./diagnostics": {
      "types": {
        "import": "./dist/plugins/diagnostics/index.d.ts",
        "require": "./dist/plugins/diagnostics/index.d.cts"
      },
      "import": "./dist/plugins/diagnostics/index.js",
      "require": "./dist/plugins/diagnostics/index.cjs"
    },
    "./persistence": {
      "types": {
        "import": "./dist/plugins/persistence/index.d.ts",
        "require": "./dist/plugins/persistence/index.d.cts"
      },
      "import": "./dist/plugins/persistence/index.js",
      "require": "./dist/plugins/persistence/index.cjs"
    },
    "./replay": {
      "types": {
        "import": "./dist/plugins/replay/index.d.ts",
        "require": "./dist/plugins/replay/index.d.cts"
      },
      "import": "./dist/plugins/replay/index.js",
      "require": "./dist/plugins/replay/index.cjs"
    },
    "./subscription-enhancer": {
      "types": {
        "import": "./dist/plugins/subscription-enhancer/index.d.ts",
        "require": "./dist/plugins/subscription-enhancer/index.d.cts"
      },
      "import": "./dist/plugins/subscription-enhancer/index.js",
      "require": "./dist/plugins/subscription-enhancer/index.cjs"
    },
    "./execution-paths": {
      "types": {
        "import": "./dist/plugins/execution-paths/index.d.ts",
        "require": "./dist/plugins/execution-paths/index.d.cts"
      },
      "import": "./dist/plugins/execution-paths/index.js",
      "require": "./dist/plugins/execution-paths/index.cjs"
    },
    "./convert": {
      "types": {
        "import": "./dist/convert/index.d.ts",
        "require": "./dist/convert/index.d.cts"
      },
      "import": "./dist/convert/index.js",
      "require": "./dist/convert/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../common/tooling/copy-types.ts dist",
    "clean": "node --import tsx ../common/tooling/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "coverage": "JOURNEY_COVERAGE_INCLUDE=packages/core/src/** pnpm --workspace-root vitest run packages/core/test --coverage --coverage.reporter=text-summary",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:exports": "publint --strict",
    "attw": "attw --pack .",
    "size": "size-limit"
  },
  "devDependencies": {
    "@rxova/journey-common": "workspace:*"
  },
  "size-limit": [
    {
      "name": "core/createLinearJourney",
      "path": "dist/index.js",
      "import": "{ createLinearJourney }",
      "limit": "10 kB"
    },
    {
      "name": "core/createGraphJourney",
      "path": "dist/index.js",
      "import": "{ createGraphJourney }",
      "limit": "10 kB"
    },
    {
      "name": "core/createGraphJourneyBuilder",
      "path": "dist/index.js",
      "import": "{ createGraphJourneyBuilder }",
      "limit": "1 kB"
    },
    {
      "name": "core/linearToGraphDefinition",
      "path": "dist/convert/index.js",
      "import": "{ linearToGraphDefinition }",
      "limit": "1 kB"
    },
    {
      "name": "core/createExecutionPathsPlugin",
      "path": "dist/plugins/execution-paths/index.js",
      "import": "{ createExecutionPathsPlugin }",
      "limit": "2.7 kB"
    },
    {
      "name": "core/createAnalyticsPlugin",
      "path": "dist/plugins/analytics/index.js",
      "import": "{ createAnalyticsPlugin }",
      "limit": "2 kB"
    },
    {
      "name": "core/createAutosavePlugin",
      "path": "dist/plugins/autosave/index.js",
      "import": "{ createAutosavePlugin }",
      "limit": "4 kB"
    },
    {
      "name": "core/createDiagnosticsPlugin",
      "path": "dist/plugins/diagnostics/index.js",
      "import": "{ createDiagnosticsPlugin }",
      "limit": "3.3 kB"
    },
    {
      "name": "core/createPersistencePlugin",
      "path": "dist/plugins/persistence/index.js",
      "import": "{ createPersistencePlugin }",
      "limit": "3.6 kB"
    },
    {
      "name": "core/createReplayPlugin",
      "path": "dist/plugins/replay/index.js",
      "import": "{ createReplayPlugin }",
      "limit": "2 kB"
    },
    {
      "name": "core/createSubscriptionEnhancerPlugin",
      "path": "dist/plugins/subscription-enhancer/index.js",
      "import": "{ createSubscriptionEnhancerPlugin }",
      "limit": "1 kB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "publint": "^0.3.18"
  }
}
