{
  "name": "@rxova/journey-react",
  "version": "1.0.1",
  "description": "React bindings for journey.",
  "keywords": [
    "react",
    "react-hooks",
    "journey",
    "state-machine",
    "wizard",
    "stepper",
    "typescript",
    "flow",
    "multi-step-form",
    "wizard-hook",
    "onboarding",
    "checkout-flow",
    "branching",
    "guards",
    "use-journey",
    "provider",
    "headless",
    "react-19",
    "state-management"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": {
        "import": "./dist/client.d.ts",
        "require": "./dist/client.d.cts"
      },
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./graph": {
      "types": {
        "import": "./dist/graph.d.ts",
        "require": "./dist/graph.d.cts"
      },
      "import": "./dist/graph.js",
      "require": "./dist/graph.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rxova/journey-core": "workspace:^",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@rxova/journey-core": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  },
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../../scripts/packages/clean-paths.ts dist/internal && node --import tsx ../../scripts/packages/copy-types.ts dist && pnpm run smoke",
    "smoke": "node --import tsx ./scripts/smoke.ts",
    "clean": "node --import tsx ../../scripts/packages/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "check:exports": "publint --strict",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "react/createLinearJourney",
      "path": "dist/index.js",
      "import": "{ createLinearJourney }",
      "limit": "2.5 kB"
    },
    {
      "name": "react/graph",
      "path": "dist/graph.js",
      "import": "{ createGraphJourney }",
      "limit": "2.5 kB"
    },
    {
      "name": "react/client",
      "path": "dist/client.js",
      "import": "{ createLinearJourney }",
      "limit": "2.5 kB"
    },
    {
      "name": "react/useJourney",
      "path": "dist/index.js",
      "import": "{ useJourney }",
      "limit": "1 kB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/journey-core": "workspace:^",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
