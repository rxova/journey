{
  "name": "@rxova/journey-react",
  "version": "1.0.0-rc.2",
  "description": "React bindings for journey.",
  "keywords": [
    "react",
    "react-hooks",
    "journey",
    "state-machine",
    "wizard",
    "stepper",
    "typescript",
    "flow"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": {
        "import": "./dist/client.d.ts",
        "require": "./dist/client.d.cts"
      },
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./headless": {
      "types": {
        "import": "./dist/headless/index.d.ts",
        "require": "./dist/headless/index.d.cts"
      },
      "import": "./dist/headless/index.js",
      "require": "./dist/headless/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rxova/journey-core": "workspace:^",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@rxova/journey-core": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  },
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../common/tooling/copy-types.ts dist",
    "clean": "node --import tsx ../common/tooling/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "coverage": "JOURNEY_COVERAGE_INCLUDE=packages/react/src/** pnpm --workspace-root vitest run packages/react/test --coverage --coverage.reporter=text-summary",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:exports": "publint --strict",
    "attw": "attw --pack .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "react/createJourney",
      "path": "dist/index.js",
      "import": "{ createJourney }",
      "limit": "4.5 kB"
    },
    {
      "name": "react/Wizard",
      "path": "dist/index.js",
      "import": "{ Wizard, useWizard, useWizardStep }",
      "limit": "5 kB"
    },
    {
      "name": "react/headless",
      "path": "dist/headless/index.js",
      "import": "{ useOwnedJourney, useJourneySnapshot, useJourneySelector }",
      "limit": "1.5 kB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/journey-common": "workspace:*",
    "@rxova/journey-core": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "publint": "^0.3.18",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
