{
  "name": "@rxova/journey-react",
  "version": "0.7.0",
  "description": "React bindings for journey.",
  "keywords": [
    "react",
    "react-hooks",
    "journey",
    "state-machine",
    "wizard",
    "stepper",
    "typescript",
    "flow"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": {
        "import": "./dist/client.d.ts",
        "require": "./dist/client.d.cts"
      },
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rxova/journey-core": "workspace:^",
    "react": ">=18.2.0"
  },
  "peerDependenciesMeta": {
    "@rxova/journey-core": {
      "optional": false
    },
    "react": {
      "optional": false
    }
  },
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../../scripts/copy-types.ts dist",
    "clean": "node --import tsx ../../scripts/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "coverage": "pnpm --workspace-root vitest run --coverage --coverage.include=packages/react/src/** --coverage.reporter=text-summary",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "publint": "publint",
    "attw": "attw --pack .",
    "size": "pnpm run size:check",
    "size:check": "pnpm run build && size-limit"
  },
  "size-limit": [
    {
      "name": "react/createJourney",
      "path": "dist/index.js",
      "import": "{ createJourney }",
      "limit": "2 kB"
    }
  ],
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
