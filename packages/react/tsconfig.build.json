{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "paths": {
      "@rxova/journey-core": ["../core/dist/index.d.ts"]
    }
  },
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    }
  ],
  "include": ["src"],
  "exclude": ["dist", "**/*.d.ts", "**/*.d.ts.map", "node_modules"]
}
