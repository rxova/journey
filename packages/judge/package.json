{
  "name": "@rxova/journey-judge",
  "version": "0.0.0",
  "description": "Answer questions about a state with rules and a sampled panel of models, run as a Journey graph.",
  "keywords": [
    "journey",
    "judge",
    "llm",
    "llm-as-judge",
    "evaluation",
    "state-machine",
    "typescript",
    "panel",
    "self-consistency"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/judge"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rxova/journey-core": "workspace:^"
  },
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../common/tooling/copy-types.ts dist",
    "clean": "node --import tsx ../common/tooling/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "coverage": "JOURNEY_COVERAGE_INCLUDE=packages/judge/src/** JOURNEY_COVERAGE_DIR=coverage/judge pnpm --workspace-root vitest run packages/judge/src --coverage --coverage.reporter=text-summary",
    "test": "pnpm --workspace-root vitest run packages/judge/src --coverage.enabled=false",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:exports": "publint --strict",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/journey-core": "workspace:^",
    "publint": "^0.3.24"
  },
  "size-limit": [
    {
      "name": "judge/createJudge",
      "path": "dist/index.js",
      "import": "{ createJudge }",
      "limit": "4 kB"
    }
  ]
}
