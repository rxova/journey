{
  "name": "@rxova/journey-devtools-bridge",
  "version": "1.0.1",
  "description": "Bridge API to connect Journey machines to browser devtools.",
  "keywords": [
    "journey",
    "devtools",
    "chrome",
    "debug",
    "state-machine",
    "typescript",
    "devtools-extension",
    "time-travel",
    "inspector",
    "diagnostics",
    "react",
    "flow",
    "observability"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/devtools-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "engines": {
    "node": ">=20.11.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rxova/journey-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@rxova/journey-core": {
      "optional": false
    }
  },
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../../scripts/packages/clean-paths.ts dist/internal && node --import tsx ../../scripts/packages/copy-types.ts dist",
    "clean": "node --import tsx ../../scripts/packages/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "check:exports": "publint --strict",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "attw": "attw --pack . --profile node16",
    "size": "size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@rxova/journey-core": "workspace:^",
    "publint": "^0.3.24"
  },
  "size-limit": [
    {
      "name": "devtools-bridge/attachJourneyDevtools",
      "path": "dist/index.js",
      "import": "{ attachJourneyDevtools }",
      "limit": "4 kB"
    }
  ]
}
