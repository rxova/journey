{
  "name": "@rxova/journey-devtools-bridge",
  "version": "1.0.0-rc.2",
  "description": "Bridge API to connect Journey machines to browser devtools.",
  "keywords": [
    "journey",
    "devtools",
    "chrome",
    "debug",
    "state-machine",
    "typescript"
  ],
  "homepage": "https://github.com/rxova/journey",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "packages/devtools-bridge"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@rxova/journey-core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@rxova/journey-core": {
      "optional": false
    }
  },
  "scripts": {
    "build": "pnpm run clean && node --import tsx ./scripts/build.ts && tsc -p tsconfig.build.json && node --import tsx ../common/tooling/copy-types.ts dist",
    "clean": "node --import tsx ../common/tooling/clean-paths.ts dist tsconfig.build.tsbuildinfo",
    "coverage": "JOURNEY_COVERAGE_INCLUDE=packages/devtools-bridge/src/** pnpm --workspace-root vitest run packages/devtools-bridge/test --coverage --coverage.reporter=text-summary",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "publint": "publint",
    "attw": "attw --pack .",
    "size": "pnpm run size:check",
    "size:check": "pnpm run build && size-limit"
  },
  "devDependencies": {
    "@rxova/journey-common": "workspace:*"
  },
  "size-limit": [
    {
      "name": "devtools-bridge/attachJourneyDevtools",
      "path": "dist/index.js",
      "import": "{ attachJourneyDevtools }",
      "limit": "3.9 kB"
    }
  ]
}
