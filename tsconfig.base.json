{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@rxova/journey-core": ["./packages/core/src/index.ts"],
      "@rxova/journey-core/connectors/immer": ["./packages/core/src/connectors/immer/immer.ts"],
      "@rxova/journey-core/testing": ["./packages/core/src/__tests__/helpers.ts"],
      "@rxova/journey-core/analytics": ["./packages/core/src/plugins/analytics/analytics.ts"],
      "@rxova/journey-core/autosave": ["./packages/core/src/plugins/autosave/autosave.ts"],
      "@rxova/journey-core/diagnostics": ["./packages/core/src/plugins/diagnostics/diagnostics.ts"],
      "@rxova/journey-core/persistence": ["./packages/core/src/plugins/persistence/persistence.ts"],
      "@rxova/journey-core/replay": ["./packages/core/src/plugins/replay/replay.ts"],
      "@rxova/journey-core/subscription-enhancer": [
        "./packages/core/src/plugins/subscription-enhancer/subscription-enhancer.ts"
      ],
      "@rxova/journey-core/execution-paths": [
        "./packages/core/src/plugins/execution-paths/execution-paths.ts"
      ],
      "@rxova/journey-core/convert": ["./packages/core/src/convert/convert.ts"],
      "@rxova/journey-react": ["./packages/react/src/index.ts"],
      "@rxova/journey-react/testing": ["./packages/react/src/__tests__/helpers.tsx"],
      "@rxova/journey-react/headless": ["./packages/react/src/headless/headless.ts"],
      "@rxova/journey-react/graph": ["./packages/react/src/graph/graph.tsx"],
      "@rxova/journey-devtools-bridge": ["./packages/devtools-bridge/src/index.ts"],
      "@rxova/journey-devtools-bridge/testing": [
        "./packages/devtools-bridge/src/__tests__/helpers.ts"
      ],
      "@rxova/journey-common": ["./packages/common/src/index.ts"],
      "@rxova/journey-common/*": ["./packages/common/src/*.ts"]
    }
  }
}
