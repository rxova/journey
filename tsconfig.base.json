{
  "compilerOptions": {
    "target": "ES2020",
    // Emit stays ES2020; `lib` only says which runtime APIs may be *typed*.
    // Journey targets evergreen browsers and Node >= 20.11, all of which have
    // had `Object.hasOwn` and `Error`'s `cause` since 2021 — without this,
    // every use needed a workaround. Matches tsconfig.test.json.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "paths": {
      "@rxova/journey-core": ["./packages/core/src/index.ts"],
      "@rxova/journey-core/connectors/immer": ["./packages/core/src/connectors/immer/immer.ts"],
      "@rxova/journey-core/testing": ["./packages/core/src/__tests__/helpers.ts"],
      "@rxova/journey-core/plugins": ["./packages/core/src/plugins/index.ts"],
      "@rxova/journey-react": ["./packages/react/src/index.ts"],
      "@rxova/journey-react/testing": ["./packages/react/src/__tests__/helpers.tsx"],
      "@rxova/journey-react/graph": ["./packages/react/src/graph.tsx"],
      "@rxova/journey-react/client": ["./packages/react/src/client.ts"],
      "@rxova/journey-devtools-bridge": ["./packages/devtools-bridge/src/index.ts"],
      "@rxova/journey-devtools-bridge/testing": [
        "./packages/devtools-bridge/src/__tests__/helpers.ts"
      ],
      "@rxova/journey-common": ["./packages/common/src/index.ts"],
      "@rxova/journey-common/*": ["./packages/common/src/*.ts"]
    }
  }
}
