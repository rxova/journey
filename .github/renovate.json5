{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // The rxova org preset (rxova/shared renovate/default.json5): weekly grouped
  // non-majors that merge themselves on a green `all checks`, majors held for
  // approval, a release-age hold, `pnpm dedupe` after every update, and the
  // `skip-changeset` label. It carries every rule this file used to spell out,
  // including the TypeScript 7 hold, so nothing is local yet. Local rules go here.
  extends: ["github>rxova/shared//renovate/default.json5"],
}
