{
  "name": "rxova-journey",
  "version": "1.0.0-rc.2",
  "description": "A declarative journey graph for non-linear UI flows",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean && node --import tsx ./packages/common/tooling/clean-paths.ts coverage",
    "changeset:pkg": "node --import tsx ./packages/common/tooling/create-package-changeset.ts",
    "version:major:check": "node --import tsx ./packages/common/tooling/check-package-major-versions.ts",
    "changeset:version": "node --import tsx ./packages/common/tooling/changeset-version.ts && pnpm run docs:version-labels:sync && pnpm run docs:release-notes:sync",
    "docs:version-labels:sync": "node --import tsx ./packages/common/tooling/sync-doc-version-labels.ts",
    "docs:version-labels:check": "node --import tsx ./packages/common/tooling/sync-doc-version-labels.ts --check",
    "docs:release-notes:sync": "node --import tsx ./packages/common/tooling/sync-doc-release-notes.ts",
    "docs:release-notes:check": "node --import tsx ./packages/common/tooling/sync-doc-release-notes.ts --check",
    "docs:api:check": "node --import tsx ./packages/common/tooling/check-public-api-tsdoc.ts",
    "docs:api:generate": "pnpm docs:api:generate:core && pnpm docs:api:generate:react && pnpm docs:api:generate:bridge",
    "docs:api:generate:core": "typedoc --options typedoc.core.json",
    "docs:api:generate:react": "typedoc --options typedoc.react.json",
    "docs:api:generate:bridge": "typedoc --options typedoc.bridge.json",
    "examples:build": "pnpm -r --filter \"./examples/*\" build",
    "packages:typecheck": "pnpm -r --filter \"./packages/*\" --filter apps-devtools typecheck && tsc --noEmit -p tsconfig.test.json",
    "release": "pnpm -r build && changeset publish",
    "releases": "pnpm run changeset:version && pnpm run release",
    "typecheck": "pnpm run packages:typecheck",
    "docs:check": "pnpm -C apps/docs build",
    "dedupe:check": "pnpm dedupe --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "commitlint": "node --import tsx ./packages/common/tooling/commitlint.ts",
    "test": "vitest run --coverage --pool=threads",
    "test:precommit": "vitest run --coverage --pool=threads --coverage.reporter=text-summary",
    "test:watch": "vitest",
    "size": "pnpm -r --reporter=append-only --workspace-concurrency=1 size",
    "size:check": "pnpm -r --reporter=append-only --workspace-concurrency=1 size:check",
    "publint": "pnpm -r --filter \"./packages/*\" publint",
    "packaging:check": "pnpm -r --filter \"./packages/*\" --filter apps-devtools build && pnpm run publint",
    "pack:smoke": "node --import tsx ./packages/common/tooling/pack-smoke.ts",
    "release:verify": "node --import tsx ./packages/common/tooling/release-verify.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "expect-type": "^1.3.0",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,cjs}": "prettier --write",
    "*.{json,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
