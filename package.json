{
  "name": "rxova-journey",
  "version": "1.0.0-rc.3",
  "description": "A declarative journey graph for non-linear UI flows",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node --import tsx ./scripts/clean-paths.ts coverage",
    "changeset:pkg": "node --import tsx ./scripts/create-package-changeset.ts",
    "version:major:check": "node --import tsx ./scripts/check-package-major-versions.ts",
    "changeset:version": "node --import tsx ./scripts/changeset-version.ts && pnpm run docs:release-notes:sync",
    "docs:release-notes:sync": "node --import tsx ./scripts/sync-doc-release-notes.ts",
    "docs:release-notes:check": "node --import tsx ./scripts/sync-doc-release-notes.ts --check",
    "docs:api:check": "pnpm exec tsc ./scripts/check-public-api-tsdoc.ts --outDir ./node_modules/.tmp-tsdoc-check --module NodeNext --moduleResolution NodeNext --target ES2020 --skipLibCheck && node ./node_modules/.tmp-tsdoc-check/check-public-api-tsdoc.js",
    "typecheck": "turbo run typecheck typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "docs": "turbo run dev --filter=@rxova/journey-docs",
    "docs:build": "turbo run build --filter=@rxova/journey-docs",
    "dev": "turbo run dev --filter=apps-demo",
    "release": "turbo run build && changeset publish",
    "releases": "pnpm run changeset:version && pnpm run release",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint-staged": "lint-staged",
    "format": "prettier . --write --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "prettier . --check --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "prepare": "husky",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports --filter=\"./packages/*\"",
    "attw": "turbo run attw --filter=\"./packages/*\"",
    "audit:check": "pnpm audit --audit-level=high --ignore-registry-errors",
    "dedupe:check": "pnpm dedupe --check",
    "pack:smoke": "node --import tsx ./scripts/pack-smoke.ts",
    "verify": "node --import tsx ./scripts/verify.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.27.7",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expect-type": "^1.3.0",
    "fast-check": "^4.6.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "publint": "^0.3.18",
    "size-limit": "^12.1.0",
    "tsx": "^4.21.0",
    "turbo": "2.10.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,cjs}": "prettier --write",
    "*.{json,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
