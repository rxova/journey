{
  "name": "rxova-journey",
  "version": "0.6.1",
  "description": "A declarative journey graph for non-linear UI flows",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean && node ./scripts/clean-paths.mjs coverage",
    "changeset": "changeset",
    "version:major:check": "node ./scripts/check-package-major-versions.mjs",
    "changeset:version": "node ./scripts/changeset-version.mjs && pnpm run docs:version-labels:sync && pnpm run docs:release-notes:sync",
    "docs:version-labels:sync": "node ./scripts/sync-doc-version-labels.mjs",
    "docs:version-labels:check": "node ./scripts/sync-doc-version-labels.mjs --check",
    "docs:release-notes:sync": "node ./scripts/sync-doc-release-notes.mjs",
    "docs:release-notes:check": "node ./scripts/sync-doc-release-notes.mjs --check",
    "release": "pnpm -r build && changeset publish",
    "releases": "pnpm run changeset:version && pnpm run release",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "commitlint": "node ./scripts/commitlint.mjs",
    "test": "vitest run --coverage",
    "test:precommit": "vitest run --coverage --coverage.reporter=text-summary",
    "test:watch": "vitest",
    "size": "pnpm -r size",
    "size:check": "pnpm -r size:check",
    "publint": "pnpm -r --filter \"./packages/*\" publint",
    "packaging:check": "pnpm -r --filter \"./packages/*\" build && pnpm run publint",
    "pack:smoke": "node ./scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.0.0",
    "@size-limit/file": "^12.0.0",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expect-type": "^1.3.0",
    "fast-check": "^4.5.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "size-limit": "^12.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "prettier --write",
    "*.{json,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "@crxjs/vite-plugin>rollup": "2.80.0",
      "serve-handler>minimatch": "3.1.5",
      "terser-webpack-plugin>serialize-javascript": "7.0.3",
      "copy-webpack-plugin>serialize-javascript": "7.0.3",
      "css-minimizer-webpack-plugin>serialize-javascript": "7.0.3"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
