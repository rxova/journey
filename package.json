{
  "name": "rxova-journey",
  "version": "0.1.0",
  "description": "A tiny zero-runtime-dependency React journey/stepper powered by a declarative journey graph.",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": "10.29.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean && rm -rf coverage",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm -r build && changeset publish",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky install",
    "commitlint": "node ./scripts/commitlint.mjs",
    "test": "vitest run --coverage",
    "test:precommit": "vitest run --coverage --coverage.reporter=text-summary",
    "test:watch": "vitest",
    "size": "pnpm -r size",
    "size:check": "pnpm -r size:check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.2",
    "@size-limit/esbuild": "^12.0.0",
    "@size-limit/file": "^12.0.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.8.1",
    "size-limit": "^12.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0",
    "*.{json,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
