{
  "name": "rxova-journey",
  "version": "1.0.0-rc.2",
  "description": "A declarative journey graph for non-linear UI flows",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": "10.30.3"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean && node --import tsx ./scripts/clean-paths.ts coverage",
    "changeset:pkg": "node --import tsx ./scripts/create-package-changeset.ts",
    "version:major:check": "node --import tsx ./scripts/check-package-major-versions.ts",
    "changeset:version": "node --import tsx ./scripts/changeset-version.ts && pnpm run docs:version-labels:sync && pnpm run docs:release-notes:sync",
    "docs:version-labels:sync": "node --import tsx ./scripts/sync-doc-version-labels.ts",
    "docs:version-labels:check": "node --import tsx ./scripts/sync-doc-version-labels.ts --check",
    "docs:release-notes:sync": "node --import tsx ./scripts/sync-doc-release-notes.ts",
    "docs:release-notes:check": "node --import tsx ./scripts/sync-doc-release-notes.ts --check",
    "docs:api:check": "pnpm exec tsc ./scripts/check-public-api-tsdoc.ts --outDir ./node_modules/.tmp-tsdoc-check --module NodeNext --moduleResolution NodeNext --target ES2020 --skipLibCheck && node ./node_modules/.tmp-tsdoc-check/check-public-api-tsdoc.js",
    "examples:build": "pnpm -r --filter \"./examples/*\" build",
    "packages:typecheck": "pnpm -r --filter \"./packages/*\" --filter apps-devtools typecheck && tsc --noEmit -p tsconfig.test.json",
    "release": "pnpm -r build && changeset publish",
    "releases": "pnpm run changeset:version && pnpm run release",
    "typecheck": "pnpm run packages:typecheck",
    "docs:check": "pnpm -C apps/docs build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "commitlint": "node --import tsx ./scripts/commitlint.ts",
    "test": "vitest run --coverage",
    "test:precommit": "vitest run --coverage --coverage.reporter=text-summary",
    "test:watch": "vitest",
    "size": "pnpm -r --reporter=append-only --workspace-concurrency=1 size",
    "size:check": "pnpm -r --reporter=append-only --workspace-concurrency=1 size:check",
    "publint": "pnpm -r --filter \"./packages/*\" publint",
    "packaging:check": "pnpm -r --filter \"./packages/*\" build && pnpm run publint",
    "pack:smoke": "node --import tsx ./scripts/pack-smoke.ts",
    "release:verify": "pnpm run version:major:check && pnpm run format:check && pnpm run lint && pnpm run docs:api:check && pnpm run docs:release-notes:check && pnpm run docs:check && pnpm run packages:typecheck && pnpm run test && pnpm run packaging:check && pnpm run pack:smoke && pnpm run examples:build && pnpm run size:check"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitest/coverage-v8": "^4.1.4",
    "esbuild": "^0.27.7",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "expect-type": "^1.3.0",
    "fast-check": "^4.6.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "publint": "^0.3.18",
    "size-limit": "^12.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,cjs}": "prettier --write",
    "*.{json,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "svgo": "3.3.3",
      "jsdom>undici": ">=7.28.0 <8.0.0",
      "cheerio>undici": ">=7.28.0 <8.0.0",
      "@crxjs/vite-plugin>rollup": "2.80.0",
      "serve-handler>minimatch": "3.1.5",
      "terser-webpack-plugin>serialize-javascript": "7.0.5",
      "copy-webpack-plugin>serialize-javascript": "7.0.5",
      "css-minimizer-webpack-plugin>serialize-javascript": "7.0.5",
      "serialize-javascript@<7.0.5": ">=7.0.5 <8.0.0",
      "path-to-regexp@<0.1.13": ">=0.1.13 <0.2.0",
      "picomatch@<2.3.2": ">=2.3.2 <3.0.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5.0.0",
      "follow-redirects@<=1.15.11": ">=1.16.0 <2.0.0",
      "webpack-dev-server@<=5.2.5": ">=5.2.6 <6.0.0",
      "body-parser@<1.20.6": ">=1.20.6 <2.0.0",
      "dompurify@<=3.4.11": ">=3.4.12 <4.0.0",
      "postcss@<8.5.10": ">=8.5.10 <9.0.0",
      "fast-uri@<=3.1.0": ">=3.1.1 <4.0.0",
      "fast-uri@<=3.1.1": ">=3.1.2 <4.0.0",
      "next@>=16.0.0 <16.2.5": ">=16.2.5 <17.0.0",
      "next@>=16.0.0 <16.2.6": ">=16.2.6 <17.0.0",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2 <7.0.0",
      "@babel/plugin-transform-modules-systemjs@>=7.12.0 <=7.29.3": ">=7.29.4 <8.0.0",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6 <6.0.0",
      "joi@<17.13.4": ">=17.13.4 <18.0.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29.0",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5 <8.0.0",
      "undici@>=7.23.0 <7.28.0": ">=7.28.0 <8.0.0",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0 <8.0.0",
      "ws@>=7.0.0 <7.5.11": ">=7.5.11 <8.0.0",
      "@babel/core@<=7.29.0": ">=7.29.6 <8.0.0",
      "brace-expansion@<1.1.16": ">=1.1.16 <2.0.0",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7 <6.0.0",
      "svgo@>=3.0.0 <3.3.4": ">=3.3.4 <4.0.0",
      "fast-uri@>=3.0.0 <=3.1.3": ">=3.1.4 <4.0.0",
      "sharp@<0.35.0": ">=0.35.0 <0.36.0",
      "next@>=16.0.0 <16.2.11": ">=16.2.11 <17.0.0",
      "fast-uri@>=3.0.0 <3.1.3": ">=3.1.3 <4.0.0",
      "postcss@<=8.5.11": ">=8.5.12 <9.0.0",
      "js-yaml@>=3.0.0 <3.15.0": ">=3.15.0 <4.0.0",
      "uuid@<11.1.1": ">=11.1.1 <12.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017"
}
