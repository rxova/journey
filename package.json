{
  "name": "rxova-journey",
  "version": "1.0.0-rc.2",
  "description": "A declarative journey graph for non-linear UI flows",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node --import tsx ./packages/common/tooling/clean-paths.ts coverage",
    "changeset:pkg": "node --import tsx ./packages/common/tooling/create-package-changeset.ts",
    "version:major:check": "node --import tsx ./packages/common/tooling/check-package-major-versions.ts",
    "changeset:version": "node --import tsx ./packages/common/tooling/changeset-version.ts && pnpm run docs:release-notes:sync",
    "docs:release-notes:sync": "node --import tsx ./packages/common/tooling/sync-doc-release-notes.ts",
    "docs:release-notes:check": "node --import tsx ./packages/common/tooling/sync-doc-release-notes.ts --check",
    "docs:api:check": "node --import tsx ./packages/common/tooling/check-public-api-tsdoc.ts",
    "typecheck": "turbo run typecheck typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "docs": "turbo run dev --filter=@rxova/journey-docs",
    "docs:build": "turbo run build --filter=@rxova/journey-docs",
    "docs:banned:check": "node --import tsx ./packages/common/tooling/check-docs-banned-identifiers.ts",
    "docs:api:generate": "pnpm docs:api:generate:core && pnpm docs:api:generate:react && pnpm docs:api:generate:bridge",
    "docs:api:generate:core": "typedoc --options typedoc.core.json",
    "docs:api:generate:react": "typedoc --options typedoc.react.json",
    "docs:api:generate:bridge": "typedoc --options typedoc.bridge.json",
    "dev": "turbo run dev --filter=apps-demo",
    "release": "turbo run build && changeset publish",
    "releases": "pnpm run changeset:version && pnpm run release",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint-staged": "lint-staged",
    "format": "prettier . --write --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "prettier . --check --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "prepare": "husky",
    "test": "vitest run --coverage --pool=threads",
    "packages:coverage": "pnpm -r --workspace-concurrency=1 --filter @rxova/journey-core --filter @rxova/journey-react --filter @rxova/journey-devtools-bridge --filter apps-devtools coverage",
    "react:min:install": "pnpm --filter @rxova/journey-react add -D react@18.2.0 react-dom@18.2.0 @types/react@18.3.27 @types/react-dom@18.3.7",
    "test:react-min": "pnpm run react:min:install && pnpm --workspace-root vitest run packages/react --coverage.enabled=false",
    "test:watch": "vitest",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports --filter=\"./packages/*\"",
    "attw": "turbo run attw --filter=\"./packages/*\"",
    "audit:check": "pnpm audit --audit-level=high",
    "dedupe:check": "pnpm dedupe --check",
    "pack:smoke": "node --import tsx ./packages/common/tooling/pack-smoke.ts",
    "verify": "node --import tsx ./packages/common/tooling/verify.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "size-limit": "^12.1.0",
    "tsx": "^4.22.4",
    "turbo": "2.10.6",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored",
    "*.{js,jsx,ts,tsx,cjs}": "prettier --write",
    "*.{json,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
