{
  "name": "rxova-journey",
  "version": "1.0.1",
  "description": "A declarative journey graph for non-linear UI flows",
  "keywords": [
    "react",
    "journey",
    "stepper",
    "state-machine",
    "wizard",
    "typescript"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "12.5.1"
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean && node --import tsx scripts/packages/clean-paths.ts coverage",
    "changeset:pkg": "rxova-repo-config add-changeset",
    "version:major:check": "rxova-repo-config check-majors",
    "changeset:overrides:check": "rxova-repo-config lint-changesets",
    "changeset:version": "rxova-repo-config version && pnpm run docs:release-notes:sync",
    "docs:release-notes:sync": "node --import tsx scripts/docs/sync-release-notes.ts",
    "docs:release-notes:check": "node --import tsx scripts/docs/sync-release-notes.ts --check",
    "docs:api:check": "rxova-repo-config check-tsdoc",
    "docs:banned:check": "rxova-repo-config check-banned",
    "typecheck": "turbo run typecheck //#typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.json",
    "docs": "turbo run dev --filter=@rxova/journey-docs",
    "docs:build": "turbo run build --filter=@rxova/journey-docs",
    "docs:api:generate": "pnpm docs:api:generate:core && pnpm docs:api:generate:react && pnpm docs:api:generate:bridge && node ./apps/docs/scripts/frontmatter-api-reference.js",
    "docs:api:generate:core": "typedoc --options typedoc.core.json",
    "docs:api:generate:react": "typedoc --options typedoc.react.json",
    "docs:api:generate:bridge": "typedoc --options typedoc.bridge.json",
    "dev": "turbo run dev --filter=apps-demo",
    "release": "turbo run build && changeset publish",
    "releases": "pnpm run changeset:version && pnpm run release",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier . --write --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "prettier . --check --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "prepare": "husky",
    "test": "turbo run test //#test:scripts",
    "test:scripts": "vitest run --coverage",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports --filter=\"./packages/*\"",
    "attw": "turbo run attw --filter=\"./packages/*\"",
    "audit:check": "pnpm audit --audit-level=high --ignore-registry-errors",
    "dedupe:check": "pnpm dedupe --check",
    "knip:check": "knip",
    "sherif:check": "sherif --fail-on-warnings",
    "pack:smoke": "turbo run pack:smoke --concurrency=1 --filter=\"./packages/*\"",
    "verify": "rxova-repo-config verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@rxova/repo-config": "^0.5.0",
    "@rxova/ts-utils": "^0.2.1",
    "@size-limit/esbuild": "^13.0.3",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "sherif": "^1.13.0",
    "size-limit": "^13.0.3",
    "tsx": "^4.23.13",
    "turbo": "2.11.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.5.1",
  "repoConfig": {
    "verify": {
      "steps": [
        {
          "name": "audit",
          "command": "pnpm run audit:check"
        },
        {
          "name": "dependency dedupe",
          "command": "pnpm exec turbo run //#dedupe:check"
        },
        {
          "name": "dependency versions",
          "command": "pnpm run sherif:check"
        },
        {
          "name": "unused code",
          "command": "pnpm run knip:check"
        },
        {
          "name": "format",
          "command": "pnpm run format:check"
        },
        {
          "name": "lint",
          "command": "pnpm run lint"
        },
        {
          "name": "major version bumps",
          "command": "pnpm run version:major:check"
        },
        {
          "name": "docs banned identifiers",
          "command": "pnpm run docs:banned:check"
        },
        {
          "name": "changeset changelog overrides",
          "command": "pnpm run changeset:overrides:check"
        },
        {
          "name": "docs api and release notes",
          "command": "pnpm exec turbo run docs:api:check docs:release-notes:check"
        },
        {
          "name": "typecheck and test",
          "command": "pnpm exec turbo run typecheck test //#typecheck:scripts //#test:scripts"
        },
        {
          "name": "build, size and package contracts",
          "command": "pnpm exec turbo run build size check:exports"
        },
        {
          "name": "pack smoke",
          "command": "pnpm run pack:smoke"
        }
      ]
    },
    "changeset": {
      "singlePackage": true,
      "aliasPrefix": "journey-",
      "includePrivate": true,
      "syncRootVersionFrom": "@rxova/journey-core"
    },
    "docs": {
      "banned": [
        {
          "name": "createJourneyMachine",
          "pattern": "\\bcreateJourneyMachine\\b"
        },
        {
          "name": "createHeadlessJourney",
          "pattern": "\\bcreateHeadlessJourney\\b"
        },
        {
          "name": "createJourneyBuilder",
          "pattern": "\\bcreateJourneyBuilder\\b"
        },
        {
          "name": "createJourneyFactory",
          "pattern": "\\bcreateJourneyFactory\\b"
        },
        {
          "name": "updateStepMetadata",
          "pattern": "\\bupdateStepMetadata\\b"
        },
        {
          "name": "machine.subscribeStart",
          "pattern": "\\bmachine\\.subscribeStart\\b"
        },
        {
          "name": "useJourneyApi",
          "pattern": "\\buseJourneyApi\\b"
        },
        {
          "name": "useStepApi",
          "pattern": "\\buseStepApi\\b"
        },
        {
          "name": "useJourneyComputed",
          "pattern": "\\buseJourneyComputed\\b"
        },
        {
          "name": "JourneyProvider",
          "pattern": "\\bJourneyProvider\\b"
        },
        {
          "name": "commandsEnabled",
          "pattern": "\\bcommandsEnabled\\b"
        },
        {
          "name": "<LinearJourney>",
          "pattern": "<LinearJourney[\\s/>]"
        },
        {
          "name": "LinearJourney.Step",
          "pattern": "\\bLinearJourney\\.Step\\b"
        },
        {
          "name": "useLinearJourney",
          "pattern": "\\buseLinearJourney\\b"
        },
        {
          "name": "useLinearJourneySelector",
          "pattern": "\\buseLinearJourneySelector\\b"
        },
        {
          "name": "useLinearJourneyStep",
          "pattern": "\\buseLinearJourneyStep\\b"
        },
        {
          "name": "TypedLinearJourney",
          "pattern": "\\bTypedLinearJourney\\b"
        },
        {
          "name": "LinearJourneyProps",
          "pattern": "\\bLinearJourneyProps\\b"
        },
        {
          "name": "LinearJourneyStepConfig",
          "pattern": "\\bLinearJourneyStepConfig\\b"
        },
        {
          "name": "LinearJourneyStepProps",
          "pattern": "\\bLinearJourneyStepProps\\b"
        },
        {
          "name": "bundle.toGraphDefinition",
          "pattern": "\\btoGraphDefinition\\b"
        },
        {
          "name": "useApi",
          "pattern": "\\buseApi\\b"
        },
        {
          "name": "useEvent",
          "pattern": "\\buseEvent\\b"
        },
        {
          "name": "useStepLifecycle",
          "pattern": "\\buseStepLifecycle\\b"
        },
        {
          "name": "journey-react/headless",
          "pattern": "journey-react\\/headless"
        },
        {
          "name": "useOwnedJourney",
          "pattern": "\\buseOwnedJourney\\b"
        },
        {
          "name": "useJourneyStepLifecycle",
          "pattern": "\\buseJourneyStepLifecycle\\b"
        },
        {
          "name": "useStepAsyncState",
          "pattern": "\\buseStepAsyncState\\b"
        },
        {
          "name": "linearToGraphDefinition",
          "pattern": "\\blinearToGraphDefinition\\b"
        },
        {
          "name": "journey-core/convert",
          "pattern": "journey-core\\/convert"
        },
        {
          "name": "createSubscriptionEnhancerPlugin",
          "pattern": "\\bcreateSubscriptionEnhancerPlugin\\b"
        },
        {
          "name": "journey-core/subscription-enhancer",
          "pattern": "journey-core\\/subscription-enhancer"
        },
        {
          "name": "host.onStepEnter",
          "pattern": "\\bhost\\.onStepEnter\\b"
        },
        {
          "name": "host.onStepLeave",
          "pattern": "\\bhost\\.onStepLeave\\b"
        },
        {
          "name": "subscribeSelector",
          "pattern": "\\bsubscribeSelector\\b"
        },
        {
          "name": "createSnapshotSource",
          "pattern": "\\bcreateSnapshotSource\\b"
        },
        {
          "name": "transitions: { (central map)",
          "pattern": "\\btransitions:\\s*\\{"
        },
        {
          "name": "createGraphJourneyBuilder",
          "pattern": "\\bcreateGraphJourneyBuilder\\b"
        },
        {
          "name": "JourneyTypeBag",
          "pattern": "\\bJourneyTypeBag\\b"
        },
        {
          "name": "registerNextStepInterceptor",
          "pattern": "\\bregisterNextStepInterceptor\\b"
        },
        {
          "name": "UseLinearJourneyResult",
          "pattern": "\\bUseLinearJourneyResult\\b"
        },
        {
          "name": "machineRef",
          "pattern": "\\bmachineRef\\b"
        },
        {
          "name": "useSubscribeEvent",
          "pattern": "\\buseSubscribeEvent\\b"
        },
        {
          "name": "bundle.useContext()",
          "pattern": "\\b\\w+\\.useContext\\("
        },
        {
          "name": "bundle.useMachine()",
          "pattern": "\\b\\w+\\.useMachine\\("
        },
        {
          "name": "bundle.useControls()",
          "pattern": "\\b\\w+\\.useControls\\("
        },
        {
          "name": "bundle.useNavigation()",
          "pattern": "\\b\\w+\\.useNavigation\\("
        },
        {
          "name": "snapshot.machine.isLoading",
          "pattern": "\\bmachine\\.isLoading\\b"
        },
        {
          "name": "snapshot.machine.isIdle",
          "pattern": "\\bmachine\\.isIdle\\b"
        },
        {
          "name": "snapshot.machine.isRunning",
          "pattern": "\\bmachine\\.isRunning\\b"
        },
        {
          "name": "snapshot.machine.isPaused",
          "pattern": "\\bmachine\\.isPaused\\b"
        },
        {
          "name": "snapshot.machine.isCompleted",
          "pattern": "\\bmachine\\.isCompleted\\b"
        },
        {
          "name": "snapshot.machine.isTerminated",
          "pattern": "\\bmachine\\.isTerminated\\b"
        },
        {
          "name": "createAutosavePlugin",
          "pattern": "\\bcreateAutosavePlugin\\b"
        },
        {
          "name": "journey-core/autosave",
          "pattern": "journey-core\\/autosave"
        },
        {
          "name": "createDiagnosticsPlugin",
          "pattern": "\\bcreateDiagnosticsPlugin\\b"
        },
        {
          "name": "getGraphDiagnostics",
          "pattern": "\\bgetGraphDiagnostics\\b"
        },
        {
          "name": "journey-core/diagnostics",
          "pattern": "journey-core\\/diagnostics"
        },
        {
          "name": "journey-core/analytics",
          "pattern": "journey-core\\/analytics"
        },
        {
          "name": "journey-core/persistence",
          "pattern": "journey-core\\/persistence"
        },
        {
          "name": "journey-core/replay",
          "pattern": "journey-core\\/replay"
        },
        {
          "name": "journey-core/execution-paths",
          "pattern": "journey-core\\/execution-paths"
        },
        {
          "name": "createStep",
          "pattern": "\\bcreateStep\\("
        },
        {
          "name": "stay()",
          "pattern": "\\bstay\\(\\)"
        },
        {
          "name": "allowRollback",
          "pattern": "\\ballowRollback\\b"
        }
      ],
      "allow": [
        "core/pre-1-0-migration.md",
        "**/releases.md"
      ],
      "exclude": [
        "**/versioned_docs/**",
        "**/api/reference/**"
      ]
    }
  }
}
