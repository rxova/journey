{
  "name": "apps-devtools",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome DevTools extension for debugging Rxova Journey machines.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run --coverage",
    "test:browser": "node -e \"console.log('Browser integration tests are temporarily disabled.')\""
  },
  "dependencies": {
    "@rxova/journey-devtools-bridge": "workspace:^",
    "@tanstack/react-virtual": "^3.14.21",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
