{
  "name": "@rxova/journey-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Astro Starlight documentation website for Rxova Journey.",
  "keywords": [
    "astro",
    "starlight",
    "documentation",
    "rxova",
    "journey",
    "react",
    "typescript"
  ],
  "homepage": "https://rxova.dev/packages/journey/",
  "bugs": {
    "url": "https://github.com/rxova/journey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/journey.git",
    "directory": "apps/docs"
  },
  "license": "MIT",
  "author": "Jonatan Kruszewski",
  "scripts": {
    "dev": "astro dev",
    "predev": "pnpm -w docs:api:generate",
    "build": "astro build",
    "prebuild": "pnpm -w docs:api:generate",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "@rxova/astro-ui": "^0.7.1",
    "@rxova/brand": "^1.6.0",
    "@rxova/journey-core": "workspace:^",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@rxova/journey-devtools-bridge": "workspace:^",
    "@rxova/journey-react": "workspace:^",
    "typescript": "^6.0.3"
  },
  "engines": {
    "//": "Tracks astro's own floor, not a choice of ours: astro >=7.4.5 declares \">=22.23.4\", so the resolved docs toolchain cannot run on Node 20 at all and the old \">=20.20.2\" claim was untrue. Raise this with astro. Private app, so it is outside `rxova-repo-config node-floor`, which only reads published packages under packages/.",
    "node": ">=22.23.4"
  }
}
