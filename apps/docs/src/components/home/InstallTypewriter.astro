---
/**
 * The rotating install-command terminal from the Docusaurus homepage.
 *
 * It was a React component, but only because it lived in a React site — the
 * animation was always pure CSS driven by three custom properties per line, so
 * the port drops to zero client JS. Same keyframes, same 4s-per-line window.
 */
interface Props {
  commands: readonly string[];
  label?: string;
  prompt?: string;
}

const { commands, label = 'Install Packages', prompt = '$' } = Astro.props;

const LINE_WINDOW_MS = 4000;
const cycleDurationMs = commands.length * LINE_WINDOW_MS;
---

<div class="terminal">
  <p class="label">{label}</p>
  <div class="display" aria-label={label}>
    <span class="prompt">{prompt}&nbsp;</span>
    <span class="command-window">
      {
        commands.map((command, index) => (
          <span
            class="line"
            style={`--terminal-line-max: ${Math.max(command.length, 1)}ch; --terminal-line-delay: ${index * LINE_WINDOW_MS}ms; --terminal-line-duration: ${cycleDurationMs}ms;`}
          >
            {command}
          </span>
        ))
      }
    </span>
  </div>
</div>

<style>
  .terminal {
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: #0d1324;
    padding: 1rem 1.25rem;
    box-shadow: 0 20px 44px -28px rgba(20, 35, 60, 0.55);
  }

  .label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(110, 231, 183, 0.95);
  }

  .display {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    height: 1.7em;
    width: 100%;
    margin-top: 0.5rem;
    overflow: hidden;
    font-family: var(--sl-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.95rem;
    line-height: 1.7;
    color: #d1fae5;
  }

  .prompt {
    flex: 0 0 auto;
    line-height: 1.7em;
    color: #34d399;
  }

  .command-window {
    position: relative;
    flex: 1 1 auto;
    height: 1.7em;
    min-width: 0;
    overflow: hidden;
  }

  .line {
    display: block;
    position: absolute;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    width: var(--terminal-line-max, 44ch);
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    border-right: 0.12em solid rgba(110, 231, 183, 0.95);
    animation:
      lineCycle var(--terminal-line-duration, 12000ms) linear infinite,
      caretBlink 900ms steps(1, end) infinite;
    animation-delay: var(--terminal-line-delay, 0ms), var(--terminal-line-delay, 0ms);
  }

  @keyframes caretBlink {
    0%,
    49% {
      border-right-color: rgba(110, 231, 183, 0.95);
    }
    50%,
    100% {
      border-right-color: transparent;
    }
  }

  @keyframes lineCycle {
    0%,
    3% {
      max-width: 0;
      opacity: 0;
    }
    4% {
      max-width: 0;
      opacity: 1;
    }
    14%,
    22% {
      max-width: var(--terminal-line-max, 44ch);
      opacity: 1;
    }
    31% {
      max-width: 0;
      opacity: 1;
    }
    33%,
    100% {
      max-width: 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line {
      animation: none;
      border-right-color: transparent;
      max-width: 0;
      opacity: 0;
    }

    .line:first-child {
      max-width: min(var(--terminal-line-max, 44ch), 100%);
      opacity: 1;
    }
  }
</style>
