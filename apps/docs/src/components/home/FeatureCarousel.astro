---
/**
 * "Why Teams Pick Journey" — the three-up carousel from the Docusaurus
 * homepage, with the same auto-advance, the same click-a-side-card-to-focus
 * behaviour, and the same edge mask.
 *
 * React became a ~40-line inline script: the whole state is one index, and
 * every slide is rendered server-side and toggled with a data attribute, so the
 * content is in the HTML whether or not the script runs.
 */
export interface FeatureSlide {
  title: string;
  body: string;
  href?: string;
}

interface Props {
  title: string;
  slides: readonly FeatureSlide[];
  autoAdvanceMs?: number;
}

const { title, slides, autoAdvanceMs = 5000 } = Astro.props;
---

<section class="carousel" data-auto-advance={autoAdvanceMs}>
  <p class="heading">{title}</p>

  <div class="shell">
    <div class="stage">
      {
        slides.map((slide, index) => (
          <article class="card" data-index={index} data-position="next">
            <p class="card-title">{slide.title}</p>
            <p class="card-body">{slide.body}</p>
            {slide.href && (
              <a class="card-link" href={slide.href}>
                Download from Chrome Web Store →
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>

  <div class="controls">
    <button type="button" aria-label="Previous feature" data-step="-1">‹</button>
    <button type="button" aria-label="Next feature" data-step="1">›</button>
  </div>

  <p class="counter"><span data-current>1</span> / {slides.length}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const counter = root.querySelector<HTMLElement>('[data-current]');
    const autoAdvanceMs = Number(root.dataset.autoAdvance ?? 5000);
    if (cards.length === 0) return;

    let active = 0;
    let timer: number | undefined;

    const render = () => {
      const previous = (active - 1 + cards.length) % cards.length;
      const next = (active + 1) % cards.length;
      cards.forEach((card, index) => {
        // Every card stays in the DOM; only three are placed. `hidden` keeps the
        // rest out of the accessibility tree and the tab order.
        const position =
          index === active
            ? 'current'
            : index === previous
              ? 'previous'
              : index === next
                ? 'next'
                : 'off';
        card.dataset.position = position;
        card.hidden = position === 'off';
      });
      if (counter) counter.textContent = String(active + 1);
    };

    const go = (delta: number) => {
      active = (active + delta + cards.length) % cards.length;
      render();
      restart();
    };

    const restart = () => {
      if (timer) window.clearInterval(timer);
      if (cards.length < 2) return;
      timer = window.setInterval(() => {
        active = (active + 1) % cards.length;
        render();
      }, autoAdvanceMs);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
      button.addEventListener('click', () => go(Number(button.dataset.step)));
      button.disabled = cards.length < 2;
    });

    // Clicking a side card focuses it, matching the React version.
    cards.forEach((card, index) => {
      card.addEventListener('click', () => {
        if (index !== active) go(index - active);
      });
    });

    render();
    restart();
  });
</script>

<style>
  .carousel {
    display: grid;
    gap: 1rem;
  }

  .heading {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sl-color-white);
  }

  .shell {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.12) 4%,
      rgba(0, 0, 0, 0.85) 10%,
      #000 14%,
      #000 86%,
      rgba(0, 0, 0, 0.85) 90%,
      rgba(0, 0, 0, 0.12) 96%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.12) 4%,
      rgba(0, 0, 0, 0.85) 10%,
      #000 14%,
      #000 86%,
      rgba(0, 0, 0, 0.85) 90%,
      rgba(0, 0, 0, 0.12) 96%,
      transparent 100%
    );
  }

  .stage {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 980px;
    margin-inline: auto;
  }

  .card {
    flex: none;
    order: 2;
    width: 68%;
    min-height: 178px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-black);
    padding: 1.25rem;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      border-color 200ms ease;
  }

  .card[data-position='previous'] {
    order: 1;
    transform: scale(0.9);
    opacity: 0.65;
  }

  .card[data-position='next'] {
    order: 3;
    transform: scale(0.9);
    opacity: 0.65;
  }

  .card[data-position='previous']:hover,
  .card[data-position='next']:hover {
    opacity: 0.85;
  }

  .card[data-position='current'] {
    order: 2;
    min-height: 198px;
    border-color: var(--sl-color-accent);
    opacity: 1;
    cursor: default;
    animation: enterFromRight 360ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes enterFromRight {
    from {
      opacity: 0.35;
      transform: translateX(54px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .card[data-position='current'] .card-title {
    font-size: 1.7rem;
  }

  .card-body {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .card-link {
    display: inline-flex;
    margin-top: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      transform 140ms ease,
      border-color 140ms ease;
  }

  .controls button:hover:not(:disabled) {
    transform: translateY(-2px);
    border-color: var(--sl-color-accent);
  }

  .controls button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .counter {
    margin: 0;
    text-align: right;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  @media (max-width: 768px) {
    .card {
      min-height: 0;
      overflow: visible;
    }

    .card[data-position='current'] {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card[data-position='current'] {
      animation: none;
      transition: none;
    }
  }
</style>
