#!/usr/bin/env sh
set -e

# eslint --fix + prettier --write over exactly the staged files.
pnpm exec lint-staged

# The whole-program checks lint-staged cannot do per-file: types are a property
# of the program, not of a file, and a unit test can only fail against the whole
# module graph. Turbo replays each from cache when its inputs are byte-identical,
# so in practice this re-checks only what the commit actually touched — without
# asking git what "changed", which is what keeps it correct mid-rebase, after a
# cherry-pick and on a merge.
#
# Each package runs its own suite (`test`), aliased onto the workspace sources
# by test/source-aliases.ts; `//#typecheck:scripts` and `//#test:scripts` cover
# the repository's own scripts under scripts/. The heavier work (audit, dedupe,
# docs, build, size, package contracts, pack smoke) stays in pre-push; see
# package.json#repoConfig.verify.
pnpm exec turbo run typecheck test //#typecheck:scripts //#test:scripts
